# ============================================================
# SGM-ITVER Backend Configuration
# ============================================================

# Database - PostgreSQL
# IMPORTANTE: usar un rol SIN SUPERUSER (p.ej. sgm_app), porque los
# superusuarios omiten RLS incluso con FORCE ROW LEVEL SECURITY.
# Crear el rol: CREATE ROLE sgm_app LOGIN PASSWORD '...' NOSUPERUSER NOBYPASSRLS;
#   GRANT USAGE ON SCHEMA public TO sgm_app;
#   GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO sgm_app;
#   GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO sgm_app;
#   GRANT EXECUTE ON ALL FUNCTIONS IN SCHEMA public TO sgm_app;
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sgm_itver
DB_USER=sgm_app
DB_PASSWORD=your_app_password

# Backblaze B2 S3
S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
S3_BUCKET=itver-maintenance
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_REGION=us-west-004

# JWT
JWT_SECRET=your-super-secret-key-change-me
JWT_EXPIRES_IN=86400

# CORS
CORS_ORIGIN=http://localhost:5173

# Seed credentials (used by scripts/seed.ts)
SEED_ADMIN_PASSWORD=admin123
SEED_TECH_PASSWORD=tecnico123

# Server
NODE_ENV=development
PORT=3000
